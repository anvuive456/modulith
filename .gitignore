# Dart/Flutter
.dart_tool/
.packages
.pub/
.pub-cache/
# Build output, anchored to each package rather than a bare `build/`, so that
# the DevTools extension's *committed* build
# (modulith_router/extension/devtools/build) is not swept up with it.
# `modulith_router/.pubignore` restates these for `pub publish`, which prunes
# a whole subtree on any `build/` rule it can reach and does not honour a
# negation.
/*/build/
/*/example/build/
coverage/
doc/api/
.flutter-plugins
.flutter-plugins-dependencies

# This is a library package, so the lockfile is not checked in — see
# https://dart.dev/guides/libraries/private-files
pubspec.lock

# FVM Version Cache
.fvm/

# Local tooling
.claude/
